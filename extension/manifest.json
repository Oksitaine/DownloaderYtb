{
  "manifest_version": 3,
  "name": "YouTube Download Button",
  "description": "Ajoute un bouton Télécharger à côté de J'aime / Je n'aime pas sur YouTube. Le téléchargement est fait en local par yt-dlp, lancé par Chrome à la demande.",
  "version": "4.0.0",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Download Button",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "*://*.youtube.com/*"
  ]
}
